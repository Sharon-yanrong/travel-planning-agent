# Copy this file to ".env" and fill in your own key.
# The code is provider-agnostic (OpenAI-compatible) — just change these 3 vars.

# --- DeepSeek (recommended, easy to get in China) ---
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Zhipu GLM (alternative) ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# --- Aliyun Tongyi / Qwen (alternative) ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- OpenAI (alternative) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
